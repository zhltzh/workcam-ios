# WorkCam backend - DEVELOPMENT environment template (placeholders only).
# Copy to backend/.env.development (git-ignored) and fill values.
# Data paths below are intentionally ISOLATED from production
# (data/dev/... vs data/prod/...) so test data can never mix with
# production data.

# [SAFE] dev posture: experimental surface allowed, no hardening.
WORKCAM_ENV=development

# [SAFE] isolated dev database + originals store.
WORKCAM_BUSINESS_DB=data/dev/business/workcam.db

# [SECRET] dev enrollment code - generate your own, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
WORKCAM_ENROLLMENT_CODE=__DEV_ENROLLMENT_CODE_PLACEHOLDER__

# [RISK] enable only when debugging the experimental upload surface.
#WORKCAM_UPLOAD_EXPERIMENTAL=1
#WORKCAM_UPLOAD_AUTH=1
#WORKCAM_UPLOAD_DIR=data/dev/uploads-experimental
#WORKCAM_UPLOAD_AUDIT=data/dev/uploads-experimental/audit.jsonl

# [RISK] never in dev - dev talks to the app directly on loopback.
#WORKCAM_TRUST_PROXY_HEADERS=1

# [SAFE] time anchor persistence for local testing.
#WORKCAM_PERSIST=1
#WORKCAM_KEY_ID=test-key-001
