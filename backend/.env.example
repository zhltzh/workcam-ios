# WorkCam backend - environment variable template (ALL VALUES ARE PLACEHOLDERS).
#
# Copy to .env.development or .env.production and fill in real values.
# The real env files are git-ignored (.gitignore: .env and .env.*).
# NEVER commit real credentials. Secret-class values should be generated
# with a script, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Security levels used below:
#   [SECRET]  credential material - generate randomly, share out-of-band,
#             never commit, never log
#   [RISK]    changes the security posture when set - read the warning
#             before enabling
#   [SAFE]    local path / toggle without security impact
#
# The application reads these from process environment variables. The
# bundled start scripts (scripts/start_dev.*, scripts/start_prod.*)
# parse the env file and export every KEY=VALUE before launching uvicorn.

# ---- deployment stage ----------------------------------------------------
# [SAFE] development | production. production hardens startup guards:
# experimental upload endpoints become a hard-boot-error; test key
# registration is disabled; missing enrollment code is warned.
WORKCAM_ENV=development

# ---- business database ---------------------------------------------------
# [SAFE] SQLite database file path. The originals object store lives
# NEXT TO this file (<dir>/originals/). Keep dev and prod on SEPARATE
# paths to keep test data away from production data.
WORKCAM_BUSINESS_DB=data/dev/business/workcam.db

# ---- device enrollment ---------------------------------------------------
# [SECRET] enrollment code for new devices. Generate ONCE per site:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# If neither this nor the _FILE variant is set, enrollment stays CLOSED.
# Default placeholder below MUST be replaced or left empty.
WORKCAM_ENROLLMENT_CODE=__GENERATE_WITH_SECRETS_TOKEN_URLSAFE_32__
# [SECRET] alternative to the above: read the code from a file
# (default: data/business/enrollment-code.txt next to the DB).
#WORKCAM_ENROLLMENT_CODE_FILE=data/business/enrollment-code.txt

# ---- experimental upload endpoints (W005 legacy surface) -----------------
# [RISK] 1 = enable the EXPERIMENTAL upload endpoints. FORBIDDEN together
# with WORKCAM_ENV=production - the app refuses to boot on that
# combination (startup guard G1 in security_config.py).
#WORKCAM_UPLOAD_EXPERIMENTAL=1
# [RISK] 1 = require device auth on upload endpoints. Required for any
# remote (non-loopback) client; leave unset for local-only debugging.
#WORKCAM_UPLOAD_AUTH=1
# [SAFE] storage root for experimental uploads and audit trail.
#WORKCAM_UPLOAD_DIR=data/uploads-experimental
# [SAFE] upload audit trail file.
#WORKCAM_UPLOAD_AUDIT=data/uploads-experimental/audit.jsonl

# ---- network posture -----------------------------------------------------
# [RISK] 1 = honor X-Forwarded--For from a trusted reverse proxy for the
# loopback gate. ONLY set this when the proxy strips client-supplied
# copies of the header; otherwise clients can forge their peer IP.
#WORKCAM_TRUST_PROXY_HEADERS=1

# ---- time anchor (WC-W004) ----------------------------------------------
# [SAFE] 1 = persist time anchors to data/time-anchors/anchors.json.
#WORKCAM_PERSIST=1
# [SAFE] key id recorded in anchor metadata (default: test-key-001).
#WORKCAM_KEY_ID=test-key-001

# ---- legacy device registry (read-compat only, pre-W009) -----------------
# [SAFE] path to the legacy devices.jsonl; new enrollments always go to
# SQLite, this is read-fallback only.
#WORKCAM_DEVICE_REGISTRY=data/uploads-experimental/devices.jsonl
