# WorkCam backend - PRODUCTION-style environment template (placeholders only).
# Copy to backend/.env.production (git-ignored) and fill values.
# "Production" here means a controlled internal deployment (see
# docs/mvp/w009-deployment.md) - this service is NOT to be exposed to
# the public internet.

# [SAFE] hardened posture: experimental endpoints hard-disabled,
# test key registration disabled, enrollment-code warning active.
WORKCAM_ENV=production

# [SAFE] isolated production database + originals store.
WORKCAM_BUSINESS_DB=data/prod/business/workcam.db

# [SECRET] production enrollment code - generate ONCE per site:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Share the code over a secure out-of-band channel. Leaving the
# placeholder means NO new device can enroll (guard G2 warns).
WORKCAM_ENROLLMENT_CODE=__PROD_ENROLLMENT_CODE_PLACEHOLDER__
# [SECRET] preferred: keep the code out of the env file entirely.
#WORKCAM_ENROLLMENT_CODE_FILE=data/prod/business/enrollment-code.txt

# [RISK] MUST stay unset in production - the app refuses to boot
# otherwise (startup guard G1).
#WORKCAM_UPLOAD_EXPERIMENTAL=
# [RISK] required when remote clients upload.
#WORKCAM_UPLOAD_AUTH=1
#WORKCAM_UPLOAD_DIR=data/prod/uploads-experimental
#WORKCAM_UPLOAD_AUDIT=data/prod/uploads-experimental/audit.jsonl

# [RISK] set ONLY behind a trusted TLS reverse proxy that strips
# client-supplied X-Forwarded-For (see docs/mvp/w009-deployment.md §6).
#WORKCAM_TRUST_PROXY_HEADERS=1

# [SAFE] time anchor settings.
#WORKCAM_PERSIST=1
#WORKCAM_KEY_ID=prod-anchor-key-001
