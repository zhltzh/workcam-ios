{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "default": {
      "format": "%(asctime)s %(levelname)s %(name)s %(message)s"
    },
    "access": {
      "format": "%(asctime)s %(levelname)s %(message)s"
    }
  },
  "handlers": {
    "console": {
      "class": "logging.StreamHandler",
      "formatter": "default",
      "stream": "ext://sys.stderr"
    },
    "file_rotate": {
      "class": "logging.handlers.RotatingFileHandler",
      "formatter": "default",
      "filename": "logs/workcam-app.log",
      "maxBytes": 10485760,
      "backupCount": 5
    },
    "access_file_rotate": {
      "class": "logging.handlers.RotatingFileHandler",
      "formatter": "access",
      "filename": "logs/workcam-access.log",
      "maxBytes": 10485760,
      "backupCount": 5
    }
  },
  "loggers": {
    "workcam": {
      "handlers": ["console", "file_rotate"],
      "level": "INFO",
      "propagate": false
    },
    "uvicorn": {
      "handlers": ["console", "file_rotate"],
      "level": "INFO",
      "propagate": false
    },
    "uvicorn.error": {
      "handlers": ["console", "file_rotate"],
      "level": "INFO",
      "propagate": false
    },
    "uvicorn.access": {
      "handlers": ["access_file_rotate"],
      "level": "INFO",
      "propagate": false
    }
  },
  "root": {
    "handlers": ["console", "file_rotate"],
    "level": "INFO"
  }
}
