# WorkCam controlled-internal-network deployment environment template.
# Copy to a real env file and fill values BEFORE first start.
# NEVER expose this service to the public internet - internal joint
# debugging only (see docs/mvp/w009-deployment.md).

# ---- business database (required) ----------------------------------------
WORKCAM_BUSINESS_DB=data/business/workcam.db

# ---- device enrollment (required for registration) ------------------------
# Generate ONCE, share over a secure out-of-band channel, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# If NEITHER this nor the _FILE below is set, enrollment is CLOSED.
WORKCAM_ENROLLMENT_CODE=
# WORKCAM_ENROLLMENT_CODE_FILE=data/business/enrollment-code.txt

# ---- experimental upload endpoints ---------------------------------------
# Joint debugging with remote clients: BOTH flags must be set.
# NEVER set EXPERIMENTAL together with WORKCAM_ENV=production - the app
# REFUSES TO START on that combination (startup guard G1).
#WORKCAM_UPLOAD_EXPERIMENTAL=1
#WORKCAM_UPLOAD_AUTH=1

# ---- proxy / network posture ----------------------------------------------
# Set ONLY when a trusted reverse proxy strips client-supplied
# X-Forwarded-For. Default (unset) = trust the DIRECT socket peer only,
# which makes forged XFF headers useless for bypassing gates.
#WORKCAM_TRUST_PROXY_HEADERS=1

# ---- deployment stage ------------------------------------------------------
# Set to 'production' for a hardened posture: experimental endpoints are
# hard-disabled regardless of the flags above.
#WORKCAM_ENV=production

# ---- legacy device registry (read-compat only) -----------------------------
# Pre-W009 devices.jsonl location. New enrollments always go to SQLite.
#WORKCAM_DEVICE_REGISTRY=data/uploads-experimental/devices.jsonl
